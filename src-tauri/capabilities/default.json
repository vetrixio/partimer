{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the panel, records, settings and widget windows",
  "windows": ["panel", "records", "settings", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "dialog:allow-ask"
  ]
}
